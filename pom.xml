<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.lakernote</groupId>
    <artifactId>meerkat</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>Meerkat</name>
    <description>Spring Boot tracing and application diagnostics</description>
    <url>https://github.com/lakernote/meerkat</url>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>lakernote</id>
            <name>lakernote</name>
            <url>https://github.com/lakernote</url>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/lakernote/meerkat.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/lakernote/meerkat.git</developerConnection>
        <url>https://github.com/lakernote/meerkat</url>
    </scm>
    <modules>
        <module>meerkat-spring-boot-common</module>
        <module>meerkat-spring-boot-3-autoconfigure</module>
        <module>meerkat-spring-boot-3-starter</module>
        <module>meerkat-spring-boot-4-autoconfigure</module>
        <module>meerkat-spring-boot-4-starter</module>
        <module>examples/meerkat-example-spring-boot-3</module>
        <module>examples/meerkat-example-spring-boot-4</module>
        <module>benchmarks</module>
    </modules>
    <properties>
        <revision>0.1.0</revision>
        <java.version>17</java.version>
        <spring-boot-3.version>3.5.16</spring-boot-3.version>
        <spring-boot-4.version>4.1.1</spring-boot-4.version>
        <openfeign.version>13.17</openfeign.version>
        <redisson.version>4.8.0</redisson.version>
        <maven-compiler-plugin.version>3.14.1</maven-compiler-plugin.version>
        <jacoco.version>0.8.16</jacoco.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <central.skipUpload>false</central.skipUpload>
    </properties>
    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.8.0</version>
                <configuration>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                    <updatePomFile>true</updatePomFile>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten-pom</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>clean-flattened-pom</id>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>central-release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                            <skipUpload>${central.skipUpload}</skipUpload>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
